+    // Patched by ~/dotfiles/lockscreen/patches (GPL-3.0, like qylock):
+    // - an empty password (Enter pressed to wake the screen) never starts PAM:
+    //   that conversation waited forever for an answer, and every later attempt
+    //   was ignored because PAM was "already running" (no error, no unlock)
+    // - a new attempt while PAM still waits answers it, or restarts PAM
+    // - PAM errors and a 20 s timeout end the attempt with an error instead of
+    //   hanging; PAM's own message (e.g. faillock's "account is locked ...
+    //   minutes left") is passed to the theme as sddm.lastError
     property var sddm: QtObject {
         signal loginFailed()
         signal loginSucceeded()
+        property string lastError: ""
 
         function login(user, password, sessionIndex) {
+            if (!password) return;
+            lastError = "";
+            if (pam.active) {
+                if (pam.responseRequired) {
+                    pam.pendingPassword = "";
+                    pam.respond(password);
+                    watchdog.restart();
+                    return;
+                }
+                pam.abort();
+            }
             pam.user = user;
             pam.pendingPassword = password;
-            pam.start();
+            pam.infoMessage = "";
+            Qt.callLater(shim.startPam);
         }
 
         function reboot() { Quickshell.execDetached(["bash", "-c", "if [ -d /run/systemd/system ]; then systemctl reboot; else loginctl reboot; fi"]); }
         function powerOff() { Quickshell.execDetached(["bash", "-c", "if [ -d /run/systemd/system ]; then systemctl poweroff; else loginctl poweroff; fi"]); }
     }
 
+    function startPam() {
+        if (pam.active) pam.abort();
+        if (pam.start()) {
+            watchdog.restart();
+        } else {
+            fail("Couldn't start the password check, try again");
+        }
+    }
+
+    function fail(text) {
+        watchdog.stop();
+        pam.pendingPassword = "";
+        if (pam.active) pam.abort();
+        sddm.lastError = text || "";
+        sddm.loginFailed();
+    }
+
+    Timer {
+        id: watchdog
+        interval: 20000
+        onTriggered: shim.fail("The password check didn't answer, try again")
+    }
+
     PamContext {
         id: pam
         property string pendingPassword: ""
+        property string infoMessage: ""
 
         onResponseRequiredChanged: {
             if (responseRequired && pendingPassword !== "") {
@@ -184,13 +229,22 @@
             }
         }
 
+        // Non-prompt messages, e.g. faillock: "The account is locked due to 3
+        // failed logins. (9 minutes left to unlock)"
+        onPamMessage: {
+            if (!responseRequired && message !== "") infoMessage = message;
+        }
+
+        onError: (error) => shim.fail("Password check error, try again")
+
         onCompleted: (result) => {
+            watchdog.stop();
             if (result === PamResult.Success) {
+                shim.sddm.lastError = "";
                 shim.sddm.loginSucceeded();
                 Quickshell.execDetached(["loginctl", "unlock-session"]);
-                // Notify success handlers
             } else {
-                shim.sddm.loginFailed();
+                shim.fail(infoMessage);
             }
         }
     }

# GENERATED by theme/render.sh from the active theme (theme/palettes) (template:
# theme/templates/starship/.config/starship.toml.tmpl). Edit the template.
#
# One line: directory, git branch + status, command duration (> 2s), prompt symbol
# (red after a failed command).
"$schema" = 'https://starship.rs/config-schema.json'
add_newline = false
format = "$directory$git_branch$git_status$cmd_duration$character"

[directory]
style = "bold {{lightblue}}"
read_only = " 󰌾"
read_only_style = "{{warn}}"
truncation_length = 3
truncate_to_repo = true

[git_branch]
symbol = " "
style = "{{ice}}"
format = "[$symbol$branch]($style) "

[git_status]
style = "{{muted}}"
format = '([$all_status$ahead_behind]($style) )'

[cmd_duration]
min_time = 2000
style = "{{warn}}"
format = "[ $duration]($style) "

[character]
success_symbol = "[❯](bold {{lightblue}})"
error_symbol = "[❯](bold {{critical}})"
vimcmd_symbol = "[❮](bold {{ice}})"

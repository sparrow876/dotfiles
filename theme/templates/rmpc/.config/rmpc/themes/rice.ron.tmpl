#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// GENERATED by theme/render.sh from the active theme (template:
// theme/templates/rmpc/.config/rmpc/themes/rice.ron.tmpl). Edit the template.
// Based on rmpc 0.11.0's assets/example_theme.ron (BSD-3-Clause, (c) mierak),
// colours replaced with the palette; solid #202636 background.
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    // Solid background (kitty's transparency only applies to the default
    // background, so these cells are opaque). Fixed colour from the reference
    // screenshot, like the cava gradient.
    background_color: "#202636",
    // Text colours: Catppuccin Mocha accents (from a reference screenshot);
    // fixed, like the background and cava.
    text_color: "#bac2de",
    header_background_color: "#202636",
    modal_background_color: "#202636",
    modal_backdrop: false,
    preview_label_style: (fg: "{{warn}}"),
    preview_metadata_group_style: (fg: "{{warn}}", modifiers: "Bold"),
    highlighted_item_style: (fg: "#cba6f7", modifiers: "Bold"),
    current_item_style: (fg: "#1e1e2e", bg: "#b4befe", modifiers: "Bold"),
    borders_style: (fg: "{{lightblue}}"),
    highlight_border_style: (fg: "{{lightblue}}"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "{{lightblue}}", bg: "{{base}}"),
        warn: (fg: "{{warn}}", bg: "{{base}}"),
        error: (fg: "{{critical}}", bg: "{{base}}"),
        debug: (fg: "{{ice}}", bg: "{{base}}"),
        trace: (fg: "{{blue}}", bg: "{{base}}"),
    ),
    // Thick rounded bar: [start, elapsed, thumb, track, end] (Nerd Font round caps)
    progress_bar: (
        symbols: ["\u{e0b6}", "█", "\u{e0b4}", "█", "\u{e0b4}"],
        track_style: (fg: "{{overlay}}"),
        elapsed_style: (fg: "{{lightblue}}"),
        thumb_style: (fg: "{{lightblue}}", bg: "{{overlay}}"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "#b4befe"),
    ),
    tab_bar: (
        active_style: (fg: "#1e1e2e", bg: "#b4befe", modifiers: "Bold"),
        inactive_style: (fg: "#a6adc8"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track), style: (fg: "#9399b2")),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist), style: (fg: "#bac2de")),
                (kind: Text(" - "), style: (fg: "#9399b2")),
                (kind: Property(Title), style: (fg: "#74c7ec")),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#bac2de"),
                default: (kind: Text("Unknown"), style: (fg: "#bac2de"))
            ),
            label_prop: (kind: Text("Artist"), style: (fg: "#9399b2", modifiers: "Bold")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#74c7ec"),
                default: (kind: Text("Unknown"), style: (fg: "#74c7ec"))
            ),
            label_prop: (kind: Text("Title"), style: (fg: "#9399b2", modifiers: "Bold")),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#cdd6f4"),
                default: (kind: Text("Unknown Album"), style: (fg: "#cdd6f4"))
            ),
            label_prop: (kind: Text("Album"), style: (fg: "#9399b2", modifiers: "Bold")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#9399b2"),
                default: (kind: Text("-"), style: (fg: "#9399b2"))
            ),
            label_prop: (kind: Text("Duration"), style: (fg: "#9399b2", modifiers: "Bold")),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "ALL",
                border_symbols: Rounded,
                size: "3",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                borders: "ALL",
                border_symbols: Rounded,
                pane: Component("progress_bar"),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#b4befe", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#b4befe", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#b4befe", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#74c7ec", modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (fg: "#74c7ec", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#b4befe"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#b4befe"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#a6adc8")), 
                (kind: Text(" / "), style: (fg: "#a6adc8")), 
                (kind: Property(Status(Duration)), style: (fg: "#a6adc8")), 
                (kind: Group([
                    (kind: Text(" ("), style: (fg: "#a6adc8")), 
                    (kind: Property(Status(Bitrate)), style: (fg: "#a6adc8")), 
                    (kind: Text(" kbps)"), style: (fg: "#a6adc8")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#f5e0dc", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#f5e0dc", modifiers: "Bold"))),
                (kind: Text(" - "), style: (fg: "#9399b2")),
                (kind: Property(Song(Album)), style: (fg: "#cdd6f4"),
                    default: (kind: Text("Unknown Album"), style: (fg: "#cdd6f4"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "{{lightblue}}"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "{{lightblue}}", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "{{warn}}", modifiers: "Bold"),
                            off_style: (fg: "{{lightblue}}", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "{{warn}}", modifiers: "Bold"),
                            off_style: (fg: "{{lightblue}}", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "{{warn}}", modifiers: "Bold"),
                            off_style: (fg: "{{lightblue}}", modifiers: "Dim"),
                            oneshot_style: (fg: "{{critical}}", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "{{warn}}", modifiers: "Bold"),
                            off_style: (fg: "{{lightblue}}", modifiers: "Dim"),
                            oneshot_style: (fg: "{{critical}}", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "{{lightblue}}", modifiers: "Bold")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "{{base}}", bg: "{{lightblue}}"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "{{base}}", bg: "{{lightblue}}"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "2", pane: Pane(Property(content: [(kind: Property(Status(StateV2(
                    playing_label: "▶", paused_label: "⏸", stopped_label: "■"))),
                    style: (fg: "{{lightblue}}", modifiers: "Bold"))]))),
                (size: "100%", pane: Pane(ProgressBar)),
                (size: "1", pane: Pane(Empty())),
                (size: "13", pane: Pane(Property(content: [
                    (kind: Property(Status(Elapsed)), style: (fg: "{{text}}")),
                    (kind: Text(" / "), style: (fg: "{{muted}}")),
                    (kind: Property(Status(Duration)), style: (fg: "{{text}}")),
                ], align: Right))),
                (size: "1", pane: Pane(Empty())),
            ]
        )
    },
    // Cava pane: wide bars rising from the bottom
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],
        bg_color: None,
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
        // fixed colours (don't follow ALT+T): pink -> purple -> cyan
        bar_color: Gradient({
              0: "#ff3d8b",
             50: "#b07cff",
            100: "#3fc5ff",
        }),
    ),
)

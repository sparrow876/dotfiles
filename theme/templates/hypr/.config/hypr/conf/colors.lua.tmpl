-- GENERATED by theme/render.sh from theme/palette.toml. Do not edit by hand.
-- Usage: local c = require("conf.colors")  ->  c.lightblue, c.rgba("lightblue", "cc"), ...
local M = {
    base      = "{{base.hex}}",
    surface   = "{{surface.hex}}",
    overlay   = "{{overlay.hex}}",
    blue      = "{{blue.hex}}",
    lightblue = "{{lightblue.hex}}",
    ice       = "{{ice.hex}}",
    text      = "{{text.hex}}",
    muted     = "{{muted.hex}}",
    warn      = "{{warn.hex}}",
    critical  = "{{critical.hex}}",

    glass_alpha = "{{glass_alpha.alpha}}",  -- hex alpha byte for frosted surfaces
    rounding    = {{rounding}},
    gaps_in     = {{gaps_in}},
    gaps_out    = {{gaps_out}},
    border_size = {{border_size}},
}

-- "rgba(rrggbbaa)" string for Hyprland color options. alpha defaults to "ff".
function M.rgba(name, alpha)
    return string.format("rgba(%s%s)", M[name], alpha or "ff")
end

-- 0xAARRGGBB integer, for options that take a number (e.g. misc.background_color).
function M.argb(name, alpha)
    return tonumber((alpha or "ff") .. M[name], 16)
end

return M

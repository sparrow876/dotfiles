// GENERATED by theme/render.sh from the active theme (theme/palettes) (template:
// theme/templates/fastfetch/.config/fastfetch/config.jsonc.tmpl). Edit the template.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "arch_small",
        "color": { "1": "{{lightblue}}", "2": "{{ice}}" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "{{lightblue}}", "title": "{{ice}}", "output": "{{text}}" },
        "key": { "width": 10 },
        "size": { "binaryPrefix": "iec", "ndigits": 1 },
        "bar": { "char": { "elapsed": "■", "total": "·" } },
        "percent": { "type": 3, "color": { "green": "{{lightblue}}", "yellow": "{{warn}}", "red": "{{critical}}" } }
    },
    "modules": [
        "break",
        { "type": "os",       "key": "os",     "format": "{name} {arch}" },
        { "type": "kernel",   "key": "kernel" },
        { "type": "wm",       "key": "wm" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "packages", "key": "pkgs" },
        { "type": "shell",    "key": "shell" },
        { "type": "cpu",      "key": "cpu",    "temp": false },
        // PCI detection lists both GPUs without waking the RTX 3050
        { "type": "gpu",      "key": "gpu",    "detectionMethod": "pci", "hideType": "none", "format": "{vendor} {name}" },
        { "type": "memory",   "key": "memory" },
        { "type": "disk",     "key": "disk",   "folders": "/" },
        { "type": "battery",  "key": "battery" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}

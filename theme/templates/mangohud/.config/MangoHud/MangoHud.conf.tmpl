# MangoHud: the in-game overlay (FPS, frame times, CPU/GPU load + temps, VRAM).
# GENERATED by theme/render.sh from the active theme ({{theme}}). Edit
# theme/templates/mangohud/.config/MangoHud/MangoHud.conf.tmpl instead.
# Used by Steam launch options `... mangohud %command%` (system/GAMING.md).
#   Shift (left) + F12   show / hide the overlay
# The first line shows the GPU's name: it must say RTX 3050 (NVIDIA). If it says
# Intel, the game is missing `prime-run` in its launch options.
# All options: /usr/share/doc/mangohud/MangoHud.conf.example

################ LOOK ################
legacy_layout=0
position=top-left
offset_x=12
offset_y=12
hud_compact
round_corners=8
font_file=/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf
font_size=18
text_outline
background_alpha=0.6
background_color={{surface.hex}}
text_color={{text.hex}}
gpu_color={{lightblue.hex}}
cpu_color={{ice.hex}}
vram_color={{lightblue.hex}}
ram_color={{ice.hex}}
engine_color={{muted.hex}}
frametime_color={{lightblue.hex}}

################ WHAT IS SHOWN ################
# GPU rows: only the RTX 3050 (PCI 0000:01:00.0, `lspci | grep NVIDIA`). The
# name line above them still says which GPU the game really uses.
pci_dev=0000:01:00.0
gpu_name
gpu_stats
gpu_temp
gpu_load_change
gpu_load_value=60,90
gpu_load_color={{text.hex}},{{warn.hex}},{{critical.hex}}
cpu_stats
cpu_temp
cpu_load_change
cpu_load_value=60,90
cpu_load_color={{text.hex}},{{warn.hex}},{{critical.hex}}
vram
fps
fps_color_change
fps_value=30,60
fps_color={{critical.hex}},{{warn.hex}},{{green.hex}}
frametime
frame_timing

################ KEYS ################
toggle_hud=Shift_L+F12

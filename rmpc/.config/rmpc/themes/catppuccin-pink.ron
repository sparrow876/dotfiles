#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// Catppuccin Macchiato, pink accent: same layout as rice.ron (made from its
// template, theme/templates/rmpc/.config/rmpc/themes/rice.ron.tmpl, with
// Macchiato colours; regenerate the same way after layout changes).
// Based on rmpc 0.11.0's assets/example_theme.ron (BSD-3-Clause, (c) mierak).
// Catppuccin palette: MIT, https://catppuccin.com. Select it in config.ron:
// theme: Some("catppuccin-pink").
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    // Solid Macchiato base (kitty's transparency only applies to the default
    // background, so these cells are opaque)
    background_color: "#24273a",
    text_color: None,
    header_background_color: "#24273a",
    modal_background_color: "#24273a",
    modal_backdrop: false,
    preview_label_style: (fg: "#c6a0f6"),
    preview_metadata_group_style: (fg: "#c6a0f6", modifiers: "Bold"),
    highlighted_item_style: (fg: "#f5bde6", modifiers: "Bold"),
    current_item_style: (fg: "#24273a", bg: "#f5bde6", modifiers: "Bold"),
    borders_style: (fg: "#f5bde6"),
    highlight_border_style: (fg: "#f5bde6"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: None,
        dir_style: None,
        playlist_style: None,
    ),
    level_styles: (
        info: (fg: "#f5bde6", bg: "#24273a"),
        warn: (fg: "#c6a0f6", bg: "#24273a"),
        error: (fg: "#ed8796", bg: "#24273a"),
        debug: (fg: "#b7bdf8", bg: "#24273a"),
        trace: (fg: "#8087a2", bg: "#24273a"),
    ),
    // Thick rounded bar: [start, elapsed, thumb, track, end] (Nerd Font round caps)
    progress_bar: (
        symbols: ["\u{e0b6}", "█", "\u{e0b4}", "█", "\u{e0b4}"],
        track_style: (fg: "#494d64"),
        elapsed_style: (fg: "#f5bde6"),
        thumb_style: (fg: "#f5bde6", bg: "#494d64"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (),
        ends_style: (),
        thumb_style: (fg: "#f5bde6"),
    ),
    tab_bar: (
        active_style: (fg: "#24273a", bg: "#f5bde6", modifiers: "Bold"),
        inactive_style: (),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track)),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist)),
                (kind: Text(" - ")),
                (kind: Property(Title)),
            ]),
            default: (kind: Property(Filename))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Artist")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title),
                default: (kind: Text("Unknown"))
            ),
            label_prop: (kind: Text("Title")),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#cad3f5"),
                default: (kind: Text("Unknown Album"), style: (fg: "#cad3f5"))
            ),
            label_prop: (kind: Text("Album")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration),
                default: (kind: Text("-"))
            ),
            label_prop: (kind: Text("Duration")),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "ALL",
                border_symbols: Rounded,
                size: "3",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                borders: "ALL",
                border_symbols: Rounded,
                pane: Component("progress_bar"),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#c6a0f6", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#c6a0f6", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#c6a0f6", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#f5bde6"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#f5bde6"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed))), 
                (kind: Text(" / ")), 
                (kind: Property(Status(Duration))), 
                (kind: Group([
                    (kind: Text(" (")), 
                    (kind: Property(Status(Bitrate))), 
                    (kind: Text(" kbps)")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#c6a0f6", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#c6a0f6", modifiers: "Bold"))),
                (kind: Text(" - ")),
                (kind: Property(Song(Album)), default: (kind: Text("Unknown Album"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#f5bde6"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#f5bde6", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "#c6a0f6", modifiers: "Bold"),
                            off_style: (fg: "#f5bde6", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "#c6a0f6", modifiers: "Bold"),
                            off_style: (fg: "#f5bde6", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "#c6a0f6", modifiers: "Bold"),
                            off_style: (fg: "#f5bde6", modifiers: "Dim"),
                            oneshot_style: (fg: "#ed8796", modifiers: "Dim"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "#c6a0f6", modifiers: "Bold"),
                            off_style: (fg: "#f5bde6", modifiers: "Dim"),
                            oneshot_style: (fg: "#ed8796", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "#f5bde6", modifiers: "Bold")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#24273a", bg: "#f5bde6"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#24273a", bg: "#f5bde6"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "2", pane: Pane(Property(content: [(kind: Property(Status(StateV2(
                    playing_label: "▶", paused_label: "⏸", stopped_label: "■"))),
                    style: (fg: "#f5bde6", modifiers: "Bold"))]))),
                (size: "100%", pane: Pane(ProgressBar)),
                (size: "1", pane: Pane(Empty())),
                (size: "13", pane: Pane(Property(content: [
                    (kind: Property(Status(Elapsed)), style: (fg: "#cad3f5")),
                    (kind: Text(" / "), style: (fg: "#a5adcb")),
                    (kind: Property(Status(Duration)), style: (fg: "#cad3f5")),
                ], align: Right))),
                (size: "1", pane: Pane(Empty())),
            ]
        )
    },
    // Cava pane: wide bars rising from the bottom
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],
        bg_color: None,
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
        // mauve -> pink -> rosewater
        bar_color: Gradient({
              0: "#c6a0f6",
             50: "#f5bde6",
            100: "#f4dbd6",
        }),
    ),
)

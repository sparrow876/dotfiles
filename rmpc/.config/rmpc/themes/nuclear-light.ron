#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
// "nuclear-light": the Nuclear music player's light palette (pink background,
// pink #ff9cb4 cards/selection, black text and borders, from Nuclear's
// packages/tailwind-config/global.css, OKLCH converted to hex; deeper shades
// of the same hues for coloured text). Same layout as rice.ron, made from its
// template (theme/templates/rmpc/.config/rmpc/themes/rice.ron.tmpl).
// Based on rmpc 0.11.0's assets/example_theme.ron (BSD-3-Clause, (c) mierak).
(
    default_album_art_path: None,
    format_tag_separator: " | ",
    browser_column_widths: [20, 38, 42],
    // Solid Nuclear pink background (kitty's transparency only applies to the
    // default background, so these cells are opaque)
    background_color: "#fadadf",
    text_color: "#000000",
    header_background_color: "#fadadf",
    modal_background_color: "#fadadf",
    modal_backdrop: false,
    preview_label_style: (fg: "#6d41a9"),
    preview_metadata_group_style: (fg: "#6d41a9", modifiers: "Bold"),
    highlighted_item_style: (fg: "#bd3964", modifiers: "Bold"),
    current_item_style: (fg: "#000000", bg: "#ff9cb4", modifiers: "Bold"),
    borders_style: (fg: "#000000"),
    highlight_border_style: (fg: "#000000"),
    symbols: (
        song: "S",
        dir: "D",
        playlist: "P",
        marker: "M",
        ellipsis: "...",
        song_style: (fg: "#000000"),
        dir_style: (fg: "#000000", modifiers: "Bold"),
        playlist_style: (fg: "#000000"),
    ),
    level_styles: (
        info: (fg: "#bd3964", bg: "#000000"),
        warn: (fg: "#6d41a9", bg: "#000000"),
        error: (fg: "#d7314b", bg: "#000000"),
        debug: (fg: "#6d41a9", bg: "#000000"),
        trace: (fg: "#674d53", bg: "#000000"),
    ),
    // Thick rounded bar: [start, elapsed, thumb, track, end] (Nerd Font round caps)
    progress_bar: (
        symbols: ["\u{e0b6}", "█", "\u{e0b4}", "█", "\u{e0b4}"],
        track_style: (fg: "#ffffff"),
        elapsed_style: (fg: "#bd3964"),
        thumb_style: (fg: "#bd3964", bg: "#ffffff"),
        use_track_when_empty: true,
    ),
    scrollbar: (
        symbols: ["│", "█", "▲", "▼"],
        track_style: (fg: "#674d53"),
        ends_style: (fg: "#674d53"),
        thumb_style: (fg: "#bd3964"),
    ),
    tab_bar: (
        active_style: (fg: "#000000", bg: "#ff9cb4", modifiers: "Bold"),
        inactive_style: (fg: "#674d53"),
    ),
    lyrics: (
        timestamp: false
    ),
    browser_song_format: [
        (
            kind: Group([
                (kind: Property(Track), style: (fg: "#000000")),
                (kind: Text(" ")),
            ])
        ),
        (
            kind: Group([
                (kind: Property(Artist), style: (fg: "#000000")),
                (kind: Text(" - ")),
                (kind: Property(Title), style: (fg: "#000000")),
            ]),
            default: (kind: Property(Filename), style: (fg: "#000000"))
        ),
    ],
    song_table_format: [
        (
            prop: (kind: Property(Artist), style: (fg: "#000000"),
                default: (kind: Text("Unknown"), style: (fg: "#000000"))
            ),
            label_prop: (kind: Text("Artist"), style: (fg: "#674d53", modifiers: "Bold")),
            width: "20%",
        ),
        (
            prop: (kind: Property(Title), style: (fg: "#000000"),
                default: (kind: Text("Unknown"), style: (fg: "#000000"))
            ),
            label_prop: (kind: Text("Title"), style: (fg: "#674d53", modifiers: "Bold")),
            width: "35%",
        ),
        (
            prop: (kind: Property(Album), style: (fg: "#000000"),
                default: (kind: Text("Unknown Album"), style: (fg: "#000000"))
            ),
            label_prop: (kind: Text("Album"), style: (fg: "#674d53", modifiers: "Bold")),
            width: "30%",
        ),
        (
            prop: (kind: Property(Duration), style: (fg: "#000000"),
                default: (kind: Text("-"), style: (fg: "#000000"))
            ),
            label_prop: (kind: Text("Duration"), style: (fg: "#674d53", modifiers: "Bold")),
            width: "15%",
            alignment: Right,
        ),
    ],
    layout: Split(
        direction: Vertical,
        panes: [
            (
                size: "4",
                pane: Split(
                    direction: Horizontal,
                    panes: [
                        (
                            size: "35",
                            borders: "LEFT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_left: "├"),
                            pane: Component("header_left")
                        ),
                        (
                            size: "100%",
                            borders: "ALL",
                            border_symbols: Inherited(parent: Rounded, top_left: "┬", top_right: "┬", bottom_left: "┴", bottom_right: "┴"),
                            pane: Component("header_center")
                        ),
                        (
                            size: "35",
                            borders: "RIGHT | TOP | BOTTOM",
                            border_symbols: Inherited(parent: Rounded, bottom_right: "┤"),
                            pane: Component("header_right")
                        ),
                    ]
                )
            ),
            (
                pane: Pane(Tabs),
                borders: "ALL",
                border_symbols: Rounded,
                size: "3",
            ),
            (
                pane: Pane(TabContent),
                size: "100%",
            ),
            (
                size: "3",
                borders: "ALL",
                border_symbols: Rounded,
                pane: Component("progress_bar"),
            ),
        ],
    ),
    components: {
        "state": Pane(Property(
            content: [
                (kind: Text("["), style: (fg: "#6d41a9", modifiers: "Bold")),
                (kind: Property(Status(StateV2( ))), style: (fg: "#6d41a9", modifiers: "Bold")),
                (kind: Text("]"), style: (fg: "#6d41a9", modifiers: "Bold")),
            ], align: Left,
        )),
        "title": Pane(Property(
            content: [
                (kind: Property(Song(Title)), style: (fg: "#000000", modifiers: "Bold"),
                    default: (kind: Text("No Song"), style: (fg: "#000000", modifiers: "Bold"))),
            ], align: Center, scroll_speed: 1
        )),
        "volume": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Property(content: [(kind: Text(""))]))),
                (size: "100%", pane: Pane(Volume(kind: Slider(symbols: (filled: "─", thumb: "●", track: "─"))))),
                (size: "3", pane: Pane(Property(content: [(kind: Property(Status(Volume)), style: (fg: "#bd3964"))], align: Right))),
                (size: "2", pane: Pane(Property(content: [(kind: Text("%"), style: (fg: "#bd3964"))]))),
            ]
        ),
        "elapsed_and_bitrate": Pane(Property(
            content: [
                (kind: Property(Status(Elapsed)), style: (fg: "#674d53")), 
                (kind: Text(" / "), style: (fg: "#674d53")), 
                (kind: Property(Status(Duration)), style: (fg: "#674d53")), 
                (kind: Group([
                    (kind: Text(" ("), style: (fg: "#674d53")), 
                    (kind: Property(Status(Bitrate)), style: (fg: "#674d53")), 
                    (kind: Text(" kbps)"), style: (fg: "#674d53")),
                ])),
            ],
            align: Left,
        )),
        "artist_and_album": Pane(Property(
            content: [
                (kind: Property(Song(Artist)), style: (fg: "#6d41a9", modifiers: "Bold"),
                    default: (kind: Text("Unknown"), style: (fg: "#6d41a9", modifiers: "Bold"))),
                (kind: Text(" - "), style: (fg: "#674d53")),
                (kind: Property(Song(Album)), style: (fg: "#000000"),
                    default: (kind: Text("Unknown Album"), style: (fg: "#000000"))),
            ], align: Center, scroll_speed: 1
        )),
        "states": Split(
            direction: Horizontal,
            panes: [
                (
                    size: "1",
                    pane: Pane(Empty())
                ),
                (
                    size: "100%",
                    pane: Pane(Property(content: [(kind: Property(Status(InputBuffer())), style: (fg: "#bd3964"), align: Left)]))
                ),
                (
                    size: "6",
                    pane: Pane(Property(content: [
                        (kind: Text("["), style: (fg: "#bd3964", modifiers: "Bold")),
                        (kind: Property(Status(RepeatV2(
                            on_label: "z",
                            off_label: "z",
                            on_style: (fg: "#6d41a9", modifiers: "Bold"),
                            off_style: (fg: "#674d53"),
                        )))),
                        (kind: Property(Status(RandomV2(
                            on_label: "x",
                            off_label: "x",
                            on_style: (fg: "#6d41a9", modifiers: "Bold"),
                            off_style: (fg: "#674d53"),
                        )))),
                        (kind: Property(Status(ConsumeV2(
                            on_label: "c",
                            off_label: "c",
                            oneshot_label: "c",
                            on_style: (fg: "#6d41a9", modifiers: "Bold"),
                            off_style: (fg: "#674d53"),
                            oneshot_style: (fg: "#d7314b"),
                        )))),
                        (kind: Property(Status(SingleV2(
                            on_label: "v",
                            off_label: "v",
                            oneshot_label: "v",
                            on_style: (fg: "#6d41a9", modifiers: "Bold"),
                            off_style: (fg: "#674d53"),
                            oneshot_style: (fg: "#d7314b", modifiers: "Bold"),
                        )))),
                        (kind: Text("]"), style: (fg: "#bd3964", modifiers: "Bold")),
                        ],
                        align: Right
                    ))
                ),
            ]
        ),
        "input_mode": Pane(Property(
            content: [
                (kind: Transform(Replace(content: (kind: Property(Status(InputMode()))), replacements: [
                    (match: "Normal", replace: (kind: Text(" NORMAL "), style: (fg: "#000000", bg: "#bd3964"))),
                    (match: "Insert", replace: (kind: Text(" INSERT "), style: (fg: "#000000", bg: "#bd3964"))),
                ])))
            ], align: Center
        )),
        "header_left": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("state")),
                (size: "1", pane: Component("elapsed_and_bitrate")),
            ]
        ),
        "header_center": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("title")),
                (size: "1", pane: Component("artist_and_album")),
            ]
        ),
        "header_right": Split(
            direction: Vertical,
            panes: [
                (size: "1", pane: Component("volume")),
                (size: "1", pane: Component("states")),
            ]
        ),
        "progress_bar": Split(
            direction: Horizontal,
            panes: [
                (size: "1", pane: Pane(Empty())),
                (size: "2", pane: Pane(Property(content: [(kind: Property(Status(StateV2(
                    playing_label: "▶", paused_label: "⏸", stopped_label: "■"))),
                    style: (fg: "#bd3964", modifiers: "Bold"))]))),
                (size: "100%", pane: Pane(ProgressBar)),
                (size: "1", pane: Pane(Empty())),
                (size: "13", pane: Pane(Property(content: [
                    (kind: Property(Status(Elapsed)), style: (fg: "#000000")),
                    (kind: Text(" / "), style: (fg: "#674d53")),
                    (kind: Property(Status(Duration)), style: (fg: "#000000")),
                ], align: Right))),
                (size: "1", pane: Pane(Empty())),
            ]
        )
    },
    // Cava pane: wide bars rising from the bottom
    cava: (
        bar_symbols: ['▁', '▂', '▃', '▄', '▅', '▆', '▇', '█'],
        inverted_bar_symbols: ['▔', '🮂', '🮃', '▀', '🮄', '🮅', '🮆', '█'],
        bg_color: None,
        bar_width: 2,
        bar_spacing: 1,
        orientation: Bottom,
        // Nuclear's red-pink -> purple -> blue
        bar_color: Gradient({
              0: "#ff4e6c",
             50: "#a87eeb",
            100: "#549de5",
        }),
    ),
)

# zathura: PDF viewer used for LaTeX (Neovim + vimtex) and as the default PDF app.
# Colours: Nord (like Neovim and Nautilus), on purpose not the rice palette.
# Options reference: `man zathurarc`.
#
# Handy keys: j/k scroll, J/K next/prev page, / search, Ctrl+G glass, Ctrl+R recolor
# (dark mode for the page itself), R reload, d two-page view, Tab outline,
# + / - zoom, a fit page, s fit width, q quit.
# Ctrl + left click on the PDF jumps to that line in Neovim (SyncTeX).

# Nord palette
#   nord0 #2E3440  nord1 #3B4252  nord2 #434C5E  nord3 #4C566A
#   nord4 #D8DEE9  nord5 #E5E9F0  nord6 #ECEFF4
#   nord8 #88C0D0  nord9 #81A1C1  nord10 #5E81AC
#   nord11 #BF616A nord13 #EBCB8B nord14 #A3BE8C

set font                    "JetBrainsMono Nerd Font 11"
set guioptions              "s"        # status bar only, no scrollbars
set adjust-open             "best-fit"
set pages-per-row           1
set scroll-page-aware       true
set selection-clipboard     clipboard  # selecting text copies it (Ctrl+V pastes)
set window-title-basename   true

# :open completion (Tab): only folders and openable documents in the folder
# being typed. Recent files were listed first and pushed those out of view.
set show-recent             0
set show-directories        true
# Rows shown while you Tab through them. zathura puts the list in a box capped
# at 300 px that doesn't scroll to the highlighted row, so more rows than fit
# (~22 px each at this font size; it shows n+1 rows + the group header) push
# the highlight out of sight. 10 -> ~266 px. Lower it if you enlarge the font.
set n-completion-items      10

# SyncTeX: vimtex starts zathura with the right inverse-search command itself.
set synctex                 true
set synctex-edit-modifier   ctrl

# Recolor (Ctrl+R): page becomes Nord dark. Images are recoloured too
# (reverse-video off): some LaTeX PDFs draw bullets etc. as tiny images, and
# keeping image colours turned those into white dots with a dark ring. Photos
# look odd in dark mode; Ctrl+R switches back to the normal page.
set recolor                 false
set recolor-keephue         true
set recolor-reverse-video   false
set recolor-darkcolor       "#ECEFF4"
# (recolor-lightcolor, the dark page background, is in glass-on/off.conf)

# Interface colours (backgrounds: glass-on/off.conf, below)
set default-fg              "#D8DEE9"
set statusbar-fg            "#D8DEE9"
set inputbar-fg             "#ECEFF4"
set notification-bg         "#3B4252"
set notification-fg         "#ECEFF4"
set notification-error-bg   "#BF616A"
set notification-error-fg   "#2E3440"
set notification-warning-bg "#EBCB8B"
set notification-warning-fg "#2E3440"
set completion-fg           "#D8DEE9"
set completion-group-fg     "#81A1C1"
set completion-highlight-bg "#5E81AC"
set completion-highlight-fg "#ECEFF4"
set index-fg                "#D8DEE9"
set index-active-bg         "#434C5E"
set index-active-fg         "#88C0D0"
set render-loading-fg       "#4C566A"
set highlight-color         "rgba(136,192,208,0.35)"
set highlight-active-color  "rgba(235,203,139,0.5)"
set highlight-fg            "#2E3440"

# Glass (Ctrl+G): slightly see-through backgrounds, blurred by Hyprland.
# glass-off.conf = solid backgrounds; glass.conf = the current choice, a
# git-ignored link to glass-on.conf or glass-off.conf made by zathura-glass
# (bin/.local/bin), which also applies the change to every open window.
include glass-off.conf
include glass.conf
map <C-g> feedkeys ":exec zathura-glass<Return>"

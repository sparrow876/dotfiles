# --- Secrets: must never be committed ---
rclone.conf
**/rclone/
*.token
*token*.json
*.pem
*.key
id_rsa*
id_ed25519*
.env
.env.*
*credentials*
*secret*
!**/libsecret*

# --- App runtime state that may land in stowed dirs ---
**/gtk-3.0/bookmarks
**/gtk-*/settings.ini
# written by theme/qt.sh with absolute paths (never commit)
qt/.config/qt5ct/qt5ct.conf
qt/.config/qt6ct/qt6ct.conf
.cache/
**/__pycache__/
node_modules/
*.log
*.swp
*~
.qmlls.ini
fastfetch/**/cache/
kitty/.config/kitty/*.socket
nvim/.config/nvim/.netrwhist
lazygit/.config/lazygit/state.yml
**/Steam/
**/BeamNG*/

# --- Never commit wallpapers or captures ---
*.jpg
*.jpeg
*.webp
*.mp4
*.mkv
# PNGs are only allowed where explicitly needed (icons, README screenshots)
*.png
!applications/**/*.png
!docs/screenshots/*.png

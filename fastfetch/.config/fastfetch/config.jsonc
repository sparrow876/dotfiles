// GENERATED by theme/render.sh from the active theme (theme/palettes) (template:
// theme/templates/fastfetch/.config/fastfetch/config.jsonc.tmpl). Edit the template.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // Small Arch logo in the theme's colors. (A picture card is also possible:
    // scripts/fastfetch-logo.sh + "type": "kitty-direct", see MAINTENANCE.md.)
    "logo": {
        "source": "arch_small",
        "color": { "1": "#7fb3ff", "2": "#cfe8ff" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "#7fb3ff", "title": "#cfe8ff", "output": "#f4f8ff" },
        "key": { "width": 10 },
        "size": { "binaryPrefix": "iec", "ndigits": 1 },
        "bar": { "char": { "elapsed": "■", "total": "·" } },
        "percent": { "type": 3, "color": { "green": "#7fb3ff", "yellow": "#f2c66d", "red": "#ef6f7a" } }
    },
    "modules": [
        "break",
        { "type": "os",       "key": "os",     "format": "{name} {arch}" },
        { "type": "kernel",   "key": "kernel" },
        { "type": "wm",       "key": "wm" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "packages", "key": "pkgs" },
        { "type": "shell",    "key": "shell" },
        // Lines are kept short (<= ~44 chars) so a half-width kitty doesn't
        // re-wrap them: kitty opens full-size, fastfetch prints, then Hyprland
        // tiles the window and kitty re-wraps long lines (stray letters at the
        // left edge, rows pushed down). {name~27} drops "12th Gen Intel(R) Core(TM) ".
        { "type": "cpu",      "key": "cpu",    "temp": false, "format": "{name~27} ({cores-physical}c/{cores-logical}t) @ {freq-max}" },
        // PCI detection lists both GPUs without waking the RTX 3050
        { "type": "gpu",      "key": "gpu",    "detectionMethod": "pci", "hideType": "none", "format": "{vendor} {name}" },
        { "type": "memory",   "key": "memory" },
        { "type": "disk",     "key": "disk",   "folders": "/", "format": "{size-percentage-bar} {size-used} / {size-total} ({size-percentage})" },
        { "type": "battery",  "key": "battery" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}

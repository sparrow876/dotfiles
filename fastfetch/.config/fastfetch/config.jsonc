// GENERATED by theme/render.sh from the active theme (theme/palettes) (template:
// theme/templates/fastfetch/.config/fastfetch/config.jsonc.tmpl). Edit the template.
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    // The picture card made by scripts/fastfetch-logo.sh (kitty draws it itself:
    // 30 x 15 cells = the 558x640 image at kitty's 13 pt font, as tall as the
    // info). Without logo.png, ~/.zshrc asks for the small Arch logo instead
    // (the colors below are for that one).
    "logo": {
        "type": "kitty-direct",
        "source": "~/.config/fastfetch/logo.png",
        "width": 30,
        "height": 15,
        "color": { "1": "#7fb3ff", "2": "#cfe8ff" },
        "padding": { "top": 0, "left": 1, "right": 3 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "#7fb3ff", "title": "#cfe8ff", "output": "#f4f8ff" },
        "key": { "width": 10 },
        "size": { "binaryPrefix": "iec", "ndigits": 1 },
        "bar": { "char": { "elapsed": "■", "total": "·" } },
        "percent": { "type": 3, "color": { "green": "#7fb3ff", "yellow": "#f2c66d", "red": "#ef6f7a" } }
    },
    "modules": [
        "break",
        { "type": "os",       "key": "os",     "format": "{name} {arch}" },
        { "type": "kernel",   "key": "kernel" },
        { "type": "wm",       "key": "wm" },
        { "type": "uptime",   "key": "uptime" },
        { "type": "packages", "key": "pkgs" },
        { "type": "shell",    "key": "shell" },
        { "type": "cpu",      "key": "cpu",    "temp": false },
        // PCI detection lists both GPUs without waking the RTX 3050
        { "type": "gpu",      "key": "gpu",    "detectionMethod": "pci", "hideType": "none", "format": "{vendor} {name}" },
        { "type": "memory",   "key": "memory" },
        { "type": "disk",     "key": "disk",   "folders": "/" },
        { "type": "battery",  "key": "battery" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}

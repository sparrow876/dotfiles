[Desktop Entry]
# rmpc (terminal MPD client) in its own kitty window, so it gets a proper icon
# and window class in rofi / Hyprland. Replaces the package's rmpc.desktop.
Type=Application
Name=rmpc
GenericName=Music Player (MPD)
Comment=Play your music library (~/Music) through MPD
# opaque window in rmpc's background colour (padding included), black default
# text (anything the theme leaves uncoloured): #fadadf for
# the nuclear-light theme (#24273a catppuccin-pink, #202636 rice; see config.ron)
Exec=kitty --class rmpc --title rmpc -o background_opacity=1 -o "background=#fadadf" -o "foreground=#000000" -e rmpc
Icon=mpd
Terminal=false
Categories=AudioVideo;Audio;Player;Music;
Keywords=Music;Audio;Player;MPD;

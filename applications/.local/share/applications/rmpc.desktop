[Desktop Entry]
# rmpc (terminal MPD client) in its own kitty window, so it gets a proper icon
# and window class in rofi / Hyprland. Replaces the package's rmpc.desktop.
Type=Application
Name=rmpc
GenericName=Music Player (MPD)
Comment=Play your music library (~/Music) through MPD
# opaque window in rmpc's background colour #202636 (padding included)
Exec=kitty --class rmpc --title rmpc -o background_opacity=1 -o "background=#202636" -e rmpc
Icon=mpd
Terminal=false
Categories=AudioVideo;Audio;Player;Music;
Keywords=Music;Audio;Player;MPD;

/* GENERATED by theme/render.sh from the active theme (theme/palettes) (template:
 * theme/templates/rofi/.config/rofi/config.rasi.tmpl). Edit the template.
 * Launcher (ALT + D): a list with small app icons, fuzzy search, most-used first.
 * The look is in theme.rasi (shared by the clipboard and emoji pickers). */
configuration {
    modes: "drun";
    show-icons: true;
    icon-theme: "Papirus-Dark";
    drun-display-format: "{name} <span size='small' alpha='60%'>{generic}</span>";
    markup-rows: true;
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    drun-match-fields: "name,generic,keywords,categories,exec";
    disable-history: false;
    max-history-size: 50;
    drun-use-desktop-cache: true;
    display-drun: "";
    kb-cancel: "Escape,Control+g";
}
@theme "theme.rasi"
